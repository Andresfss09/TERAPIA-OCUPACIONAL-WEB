# Variables de entorno opcionales para conectar con Supabase en la nube
# Si se dejan en blanco o no se configuran, la aplicación funciona al 100%
# con almacenamiento local en tiempo real y sincronización entre pestañas.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-de-supabase
